{
  "name": "tronbox",
  "namespace": "tronprotocol",
  "version": "4.8.0",
  "description": "TronBox - Simple development framework for Tron",
  "keywords": [
    "TronBox",
    "TRON",
    "Solidity",
    "Truffle",
    "Contract"
  ],
  "scripts": {
    "build": "scripts/build.sh",
    "pretest": "npm install --prefix test/fixture --no-progress --silent",
    "test": "[ -f test/.env ] && . test/.env; mocha 'test/*.test.js' --ignore 'test/*.testnet.test.js'",
    "test:testnet": "[ -f test/.env ] && . test/.env; mocha 'test/*.testnet.test.js'",
    "test:all": "npm test && npm run test:testnet",
    "prepare": "npm run build",
    "lint": "eslint \"sample-projects/**/*.js\" \"src/**/*.js\" \"test/**/*.js\"",
    "format": "prettier --write \"sample-projects/**/*.js\" \"src/**/*.js\" \"test/**/*.js\""
  },
  "dependencies": {
    "@solidity-parser/parser": "0.20.2",
    "ajv": "6.14.0",
    "async": "2.6.4",
    "axios": "1.16.1",
    "bignumber.js": "7.2.1",
    "chai": "4.1.2",
    "chalk": "2.4.2",
    "debug": "3.2.7",
    "enquirer": "2.4.1",
    "ethers": "6.15.0",
    "find-up": "4.1.0",
    "fs-extra": "8.1.0",
    "glob": "13.0.6",
    "graphlib": "2.1.8",
    "homedir": "0.6.0",
    "lodash": "4.18.1",
    "mkdirp": "0.5.6",
    "mocha": "11.7.4",
    "node-dir": "0.1.17",
    "source-map-support": "0.5.21",
    "tmp": "0.2.6",
    "tronweb": "6.3.0",
    "yargs": "15.4.1",
    "yauzl": "3.2.1"
  },
  "devDependencies": {
    "@babel/cli": "8.0.1",
    "@babel/core": "8.0.1",
    "@babel/plugin-transform-runtime": "8.0.1",
    "@babel/preset-env": "8.0.2",
    "eslint": "9.39.1",
    "eslint-plugin-n": "17.23.1",
    "globals": "16.1.0",
    "prettier": "2.8.8",
    "tslib": "2.8.1"
  },
  "overrides": {
    "mocha": {
      "serialize-javascript": "7.0.5"
    },
    "tronweb": {
      "axios": "1.16.1"
    }
  },
  "bin": {
    "tronbox": "build/tronbox.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tronprotocol/tronbox.git"
  },
  "homepage": "https://tronbox.io",
  "bugs": {
    "url": "https://github.com/tronprotocol/tronbox/issues"
  },
  "originalAuthor": "consensys.net",
  "author": "tron.network",
  "authors": [
    {
      "name": "Tim Coulter",
      "email": "tim@timothyjcoulter.com",
      "url": "https://github.com/tcoulter"
    },
    {
      "name": "alinger",
      "email": "alinger@forke.cn"
    },
    {
      "name": "Francesco Sullo",
      "email": "francesco@sullo.co",
      "url": "https://github.com/sullof"
    },
    {
      "name": "Kang JianCheng",
      "email": "1063303665@qq.com",
      "url": "https://github.com/kjc233"
    }
  ],
  "publishConfig": {
    "access": "public"
  }
}
